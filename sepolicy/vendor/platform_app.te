# platform_app_all covers both platform_app (targetSdk >= 37) and
# platform_app_36 (targetSdk <= 36)

allow platform_app_all app_data_file:file execute;
allow platform_app_all vendor_hal_camerapostproc_xiaomi_hwservice:hwservice_manager find;
allow platform_app_all hal_misys_service:service_manager find;

binder_call(platform_app_all, hal_camera_default)

get_prop(platform_app_all, vendor_camera_prop)
get_prop(platform_app_all, vendor_camera_p3enable_prop)
get_prop(platform_app_all, vendor_fp_prop)
get_prop(platform_app_all, vendor_display_prop)
get_prop(platform_app_all, vendor_panel_info_prop)

allow platform_app_all proc_pressure_mem:file r_file_perms;
allow platform_app_all proc_pressure_cpu:file r_file_perms;
allow platform_app_all proc_pressure_io:file r_file_perms;

# FastRPC directory lookup. Opening vendor_qdsp_device/vendor_xdsp_device from
# an app is blocked by neverallows in qcom sepolicy_vndr (common/domain.te).
allow platform_app_all adsprpcd_file:dir { search getattr };
